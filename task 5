void main() {
  List<String> words = [
    "apple",
    "banana",
    "apple",
    "orange",
    "banana",
    "apple"
  ];

  Set<String> unique = {};
  Map<String, int> count = {};

  for (var word in words) {
    unique.add(word);
    count[word] = (count[word] ?? 0) + 1;
  }

  print(unique);
  print(unique.length);
  print(count);
}