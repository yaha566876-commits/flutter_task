void main() {
  Map<String, int> students = {
    'Yousef': 85,
    'Yaha': 92,
    'Omar': 76,
    'Mahmoud': 88,
    'Ali': 70,
  };

  int total = 0;

  for (var student in students.entries) {
    print('${student.key}: ${student.value}');
    total += student.value;

    if (student.value >= 80) {
      print('${student.key} scored 80 or higher.');
    }
  }

  double average = total / students.length;
  print('Average grade: $average');
}