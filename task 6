import 'dart:io';

void main() {
  int balance = 2500;
  int choice = 0;

  do {
    print("1. Balance");
    print("2. Deposit");
    print("3. Withdraw");
    print("4. Exit");

    choice = int.parse(stdin.readLineSync()!);

    if (choice == 1) {
      print("Balance = $balance");
    }

    else if (choice == 2) {
      print("Enter money:");
      int money = int.parse(stdin.readLineSync()!);
      balance = balance + money;
    }

    else if (choice == 3) {
      print("Enter money:");
      int money = int.parse(stdin.readLineSync()!);

      if (money <= balance) {
        balance = balance - money;
      } else {
        print("Not enough money");
      }
    }

    else if (choice == 4) {
      print("Goodbye");
    }

    else {
      print("Invalid option");
    }

  } while (choice != 4);
}