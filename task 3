void main() {
  Map<String, int> products = {
    "Phone": 100,
    "Book": 30,
    "Bag": 60
  };

  int total = 0;
  int max = 0;
  String mostExpensiveProduct = "";

  for (var p in products.entries) {
    print("${p.key}: ${p.value}");

    total += p.value;

    if (p.value > 50) {
      print(p.key);
    }

    if (p.value > max) {
      max = p.value;
      mostExpensiveProduct = p.key;
    }
  }

  print("Total = $total");
  print("Most expensive product: $mostExpensiveProduct");
  print("Price = $max");
}