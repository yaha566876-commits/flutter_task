class Student {
  String name;
  int id;
  double math;
  double english;
  double science;

  Student(this.name, this.id, this.math, this.english, this.science);

  double calculateAverage() {
    return (math + english + science) / 3;
  }

  String getResult() {
    double average = calculateAverage();

    if (average >= 90) {
      return "Excellent";
    } else if (average >= 80) {
      return "Very Good";
    } else if (average >= 70) {
      return "Good";
    } else if (average >= 50) {
      return "Pass";
    } else {
      return "Fail";
    }
  }

  void displayReport() {
    print("Name: $name");
    print("ID: $id");
    print("Math: $math");
    print("English: $english");
    print("Science: $science");
    print("Average: ${calculateAverage()}");
    print("Result: ${getResult()}");
  }
}

void main() {
  Student student = Student("Youssef", 1, 90, 85, 95);

  student.displayReport();
}
